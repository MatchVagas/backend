{
  "info": {
    "name": "MatchVagas API",
    "description": "Coleção completa de testes da API MatchVagas cobrindo todos os Requisitos Funcionais (RF001–RF010)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "token_candidato", "value": "", "type": "string" },
    { "key": "token_empresa", "value": "", "type": "string" },
    { "key": "token_admin", "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "RF001 — Cadastro de Usuários",
      "item": [
        {
          "name": "Cadastrar candidato",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Retorna tipoUsuario CANDIDATO', () => pm.expect(pm.response.json().tipoUsuario).to.eql('CANDIDATO'));",
            "pm.test('Não expõe senha', () => pm.expect(pm.response.json().senha).to.be.undefined);"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"senha\": \"senha123\",\n  \"dataNascimento\": \"1995-05-10T00:00:00\",\n  \"tipoUsuario\": \"CANDIDATO\"\n}" }
          }
        },
        {
          "name": "Cadastrar empresa",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Retorna tipoUsuario EMPRESA', () => pm.expect(pm.response.json().tipoUsuario).to.eql('EMPRESA'));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Tech Corp RH\",\n  \"email\": \"rh@techcorp.com\",\n  \"senha\": \"senha123\",\n  \"dataNascimento\": \"1990-01-01T00:00:00\",\n  \"tipoUsuario\": \"EMPRESA\"\n}" }
          }
        },
        {
          "name": "[ERRO] Email duplicado deve retornar 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 para email duplicado', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Outro João\",\n  \"email\": \"joao@email.com\",\n  \"senha\": \"outrasenha\",\n  \"dataNascimento\": \"1995-05-10T00:00:00\",\n  \"tipoUsuario\": \"CANDIDATO\"\n}" }
          }
        },
        {
          "name": "[ERRO] Campos obrigatórios ausentes deve retornar 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 para dados inválidos', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"\",\n  \"email\": \"emailinvalido\",\n  \"senha\": \"123\"\n}" }
          }
        }
      ]
    },

    {
      "name": "RF002 — Autenticação",
      "item": [
        {
          "name": "Login candidato — salva token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna token JWT', () => { const r = pm.response.json(); pm.expect(r.token).to.be.a('string'); pm.expect(r.tipo).to.eql('Bearer'); });",
            "pm.test('Perfil é CANDIDATO', () => pm.expect(pm.response.json().perfil).to.eql('CANDIDATO'));",
            "pm.collectionVariables.set('token_candidato', pm.response.json().token);"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"joao@email.com\",\n  \"senha\": \"senha123\"\n}" }
          }
        },
        {
          "name": "Login empresa — salva token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Perfil é EMPRESA', () => pm.expect(pm.response.json().perfil).to.eql('EMPRESA'));",
            "pm.collectionVariables.set('token_empresa', pm.response.json().token);"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"rh@techcorp.com\",\n  \"senha\": \"senha123\"\n}" }
          }
        },
        {
          "name": "[ERRO] Senha incorreta deve retornar 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 para senha incorreta', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"joao@email.com\",\n  \"senha\": \"senhaErrada\"\n}" }
          }
        },
        {
          "name": "[ERRO] Email não cadastrado deve retornar 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404 para usuário não encontrado', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"naoexiste@email.com\",\n  \"senha\": \"senha123\"\n}" }
          }
        }
      ]
    },

    {
      "name": "RF003 — Perfil do Candidato",
      "item": [
        {
          "name": "Criar perfil de candidato",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Retorna CPF', () => pm.expect(pm.response.json().cpf).to.eql('123.456.789-00'));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/candidatos",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_candidato}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cpf\": \"123.456.789-00\",\n  \"resumoProfissional\": \"Desenvolvedor Java com 3 anos de experiência\",\n  \"disponibilidade\": \"Imediata\",\n  \"pretensaoSalarial\": 5000.00\n}" }
          }
        },
        {
          "name": "Visualizar meu perfil",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna nome e email', () => { const r = pm.response.json(); pm.expect(r.nome).to.be.a('string'); pm.expect(r.email).to.be.a('string'); });"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/candidatos/meu-perfil",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_candidato}}" }]
          }
        },
        {
          "name": "Atualizar perfil de candidato",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Pretensão salarial atualizada', () => pm.expect(pm.response.json().pretensaoSalarial).to.eql(8000));"
          ]}}],
          "request": {
            "method": "PUT", "url": "{{base_url}}/api/candidatos/meu-perfil",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_candidato}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cpf\": \"123.456.789-00\",\n  \"resumoProfissional\": \"Desenvolvedor Java Sênior com 5 anos\",\n  \"disponibilidade\": \"30 dias\",\n  \"pretensaoSalarial\": 8000.00\n}" }
          }
        },
        {
          "name": "[ERRO] Sem token deve retornar 403",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403 sem token', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/candidatos/meu-perfil"
          }
        }
      ]
    },

    {
      "name": "RF004 — Perfil da Empresa",
      "item": [
        {
          "name": "Cadastrar empresa (requer porteId e ramoId existentes)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Retorna nomeFantasia', () => pm.expect(pm.response.json().nomeFantasia).to.eql('Tech Corp'));",
            "pm.test('Retorna usuarioGestorId', () => pm.expect(pm.response.json().usuarioGestorId).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/empresas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"razaoSocial\": \"Tech Corp Ltda\",\n  \"nomeFantasia\": \"Tech Corp\",\n  \"descricao\": \"Empresa de desenvolvimento de software\",\n  \"porteId\": 1,\n  \"ramoId\": 1,\n  \"site\": \"https://techcorp.com.br\"\n}" }
          }
        },
        {
          "name": "Visualizar minha empresa",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna nomeGestor', () => pm.expect(pm.response.json().nomeGestor).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/empresas/minha-empresa",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_empresa}}" }]
          }
        },
        {
          "name": "Listar todas as empresas (público)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/empresas"
          }
        },
        {
          "name": "Atualizar empresa",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Nome fantasia atualizado', () => pm.expect(pm.response.json().nomeFantasia).to.eql('Tech Corp 2.0'));"
          ]}}],
          "request": {
            "method": "PUT", "url": "{{base_url}}/api/empresas/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"razaoSocial\": \"Tech Corp Ltda\",\n  \"nomeFantasia\": \"Tech Corp 2.0\",\n  \"descricao\": \"Empresa de tecnologia e inovação\",\n  \"porteId\": 1,\n  \"ramoId\": 1,\n  \"site\": \"https://techcorp2.com.br\"\n}" }
          }
        },
        {
          "name": "[ERRO] Candidato não pode cadastrar empresa",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403 para candidato', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/empresas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_candidato}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"99.999.999/0001-99\",\n  \"razaoSocial\": \"Empresa Fake\",\n  \"nomeFantasia\": \"Fake\",\n  \"porteId\": 1,\n  \"ramoId\": 1\n}" }
          }
        },
        {
          "name": "[ERRO] CNPJ duplicado deve retornar 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 para CNPJ duplicado', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/empresas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"cnpj\": \"12.345.678/0001-90\",\n  \"razaoSocial\": \"Duplicada\",\n  \"nomeFantasia\": \"Dup\",\n  \"porteId\": 1,\n  \"ramoId\": 1\n}" }
          }
        }
      ]
    },

    {
      "name": "RF005 — Cadastro de Vagas",
      "item": [
        {
          "name": "Cadastrar vaga (EMPRESA — empresa vinculada automaticamente)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Retorna id da vaga', () => pm.expect(pm.response.json().id).to.be.a('number'));",
            "pm.test('Retorna empresaId', () => pm.expect(pm.response.json().empresaId).to.be.a('number'));",
            "pm.test('Retorna título', () => pm.expect(pm.response.json().titulo).to.eql('Desenvolvedor Java Pleno'));",
            "pm.collectionVariables.set('vaga_id', pm.response.json().id);"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/vagas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Desenvolvedor Java Pleno\",\n  \"descricao\": \"Vaga para desenvolvedor Java com experiência em Spring Boot e microsserviços\",\n  \"requisitos\": \"Java 17+, Spring Boot, JPA/Hibernate, Git\",\n  \"tipoVagaId\": 1,\n  \"modalidadeId\": 1,\n  \"salarioMinimo\": 5000.00,\n  \"salarioMaximo\": 8000.00,\n  \"beneficios\": \"Vale refeição, Plano de saúde\",\n  \"cargaHoraria\": \"40h/semana\",\n  \"idadeMinima\": 18,\n  \"idadeMaxima\": 45,\n  \"escolaridadeId\": 1,\n  \"areaAtuacao\": \"Tecnologia\",\n  \"dataExpiracao\": \"2027-12-31T23:59:59\",\n  \"statusVagaId\": 1,\n  \"numeroVagas\": 3,\n  \"cidadeId\": 1\n}" }
          }
        },
        {
          "name": "[ERRO] Candidato não pode criar vaga",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403 para candidato', () => pm.response.to.have.status(403));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/vagas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_candidato}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Vaga Indevida\",\n  \"descricao\": \"Candidato tentando criar vaga\",\n  \"requisitos\": \"Não deveria funcionar\",\n  \"tipoVagaId\": 1,\n  \"modalidadeId\": 1,\n  \"salarioMinimo\": 1000.00,\n  \"salarioMaximo\": 2000.00,\n  \"cargaHoraria\": \"40h/semana\",\n  \"idadeMinima\": 18,\n  \"idadeMaxima\": 40,\n  \"escolaridadeId\": 1,\n  \"areaAtuacao\": \"TI\",\n  \"dataExpiracao\": \"2027-12-31T23:59:59\",\n  \"statusVagaId\": 1,\n  \"numeroVagas\": 1,\n  \"cidadeId\": 1\n}" }
          }
        },
        {
          "name": "[ERRO] Salário mínimo maior que máximo deve retornar 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 para salário inválido', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{base_url}}/api/vagas",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Vaga Inválida\",\n  \"descricao\": \"Testando salário inválido aqui com texto longo\",\n  \"requisitos\": \"Qualquer requisito\",\n  \"tipoVagaId\": 1,\n  \"modalidadeId\": 1,\n  \"salarioMinimo\": 9000.00,\n  \"salarioMaximo\": 5000.00,\n  \"cargaHoraria\": \"40h/semana\",\n  \"idadeMinima\": 18,\n  \"idadeMaxima\": 45,\n  \"escolaridadeId\": 1,\n  \"areaAtuacao\": \"TI\",\n  \"dataExpiracao\": \"2027-12-31T23:59:59\",\n  \"statusVagaId\": 1,\n  \"numeroVagas\": 1,\n  \"cidadeId\": 1\n}" }
          }
        }
      ]
    },

    {
      "name": "RF006 — Manutenção de Vagas",
      "item": [
        {
          "name": "Atualizar vaga",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Título atualizado', () => pm.expect(pm.response.json().titulo).to.eql('Desenvolvedor Java Sênior'));"
          ]}}],
          "request": {
            "method": "PUT", "url": "{{base_url}}/api/vagas/{{vaga_id}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token_empresa}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Desenvolvedor Java Sênior\",\n  \"descricao\": \"Vaga atualizada para nível sênior com foco em arquitetura\",\n  \"requisitos\": \"Java 17+, Spring Boot, Kubernetes, Docker\",\n  \"tipoVagaId\": 1,\n  \"modalidadeId\": 1,\n  \"salarioMinimo\": 8000.00,\n  \"salarioMaximo\": 12000.00,\n  \"beneficios\": \"Vale refeição, Plano de saúde, Stock options\",\n  \"cargaHoraria\": \"40h/semana\",\n  \"idadeMinima\": 25,\n  \"idadeMaxima\": 50,\n  \"escolaridadeId\": 1,\n  \"areaAtuacao\": \"Tecnologia\",\n  \"dataExpiracao\": \"2027-12-31T23:59:59\",\n  \"statusVagaId\": 1,\n  \"numeroVagas\": 2,\n  \"cidadeId\": 1\n}" }
          }
        },
        {
          "name": "Listar minhas vagas",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/vagas/minhas",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_empresa}}" }]
          }
        },
        {
          "name": "Remover vaga",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE", "url": "{{base_url}}/api/vagas/{{vaga_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_empresa}}" }]
          }
        },
        {
          "name": "[ERRO] Remover vaga inexistente deve retornar 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "DELETE", "url": "{{base_url}}/api/vagas/99999",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_empresa}}" }]
          }
        }
      ]
    },

    {
      "name": "RF007 — Busca e Filtragem de Vagas",
      "item": [
        {
          "name": "Listar todas as vagas (público)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna array', () => pm.expect(pm.response.json()).to.be.an('array'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/vagas"
          }
        },
        {
          "name": "Filtrar vagas por título",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Resultados contêm Java', () => pm.response.json().forEach(v => pm.expect(v.titulo.toLowerCase()).to.include('java')));"
          ]}}],
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/api/vagas?titulo=Java", "query": [{ "key": "titulo", "value": "Java" }] }
          }
        },
        {
          "name": "Filtrar vagas por área de atuação",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/api/vagas?areaAtuacao=Tecnologia", "query": [{ "key": "areaAtuacao", "value": "Tecnologia" }] }
          }
        },
        {
          "name": "Buscar vaga por ID",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Retorna id', () => pm.expect(pm.response.json().id).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/vagas/1"
          }
        },
        {
          "name": "[ERRO] Vaga inexistente deve retornar 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{base_url}}/api/vagas/99999"
          }
        }
      ]
    },

    {
      "name": "RF008 — Candidatura à Vaga",
      "item": [
        {
          "name": "Candidatar-se a uma vaga",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
