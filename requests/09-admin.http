### ── GESTÃO DE VAGAS ──────────────────────────────────────────────

### [12] Listar todas as vagas (admin vê todas, inclusive inativas)
GET {{base_url}}/api/admin/vagas
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("É uma lista", function() { client.assert(Array.isArray(response.body)); });
  if (response.body.length > 0) {
    client.global.set("vaga_admin_id", response.body[0].id);
    client.global.set("vaga_id", response.body[0].id);
  }
%}

