### ── GESTÃO DE ADMINISTRADORES ────────────────────────────────────

### [18] Listar todos os administradores
GET {{base_url}}/api/admin/admins
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  if (response.body.length > 0) {
    client.global.set("admin_id", response.body[0].id);
    client.global.set("usuario_admin_id", response.body[0].usuario
      ? response.body[0].usuario.id
      : client.global.get("usuario_admin_id"));
  }
%}

###

### [19] Buscar administrador por ID
GET {{base_url}}/api/admin/admins/{{admin_id}}
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [20] Criar administrador (promover usuário)
POST {{base_url}}/api/admin/admins
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "usuarioId": {{usuario_admin_id}},
  "nivel": "GERENTE",
  "departamentoId": {{departamento_id}},
  "permissoes": "USUARIOS,VAGAS,EMPRESAS"
}

> {%
  client.test("Status 201 ou 400 (já existe)", function() {
    client.assert(response.status === 201 || response.status === 400 || response.status === 409);
  });
  if (response.status === 201) {
    client.global.set("admin_id", response.body.id);
  }
%}

###

### [21] Atualizar dados do administrador
PUT {{base_url}}/api/admin/admins/{{admin_id}}
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "usuarioId": {{usuario_admin_id}},
  "nivel": "DIRETOR",
  "departamentoId": {{departamento_id}},
  "permissoes": "USUARIOS,VAGAS,EMPRESAS,RELATORIOS"
}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### ── ESTATÍSTICAS ────────────────────────────────────────────────

### [22] Estatísticas gerais do sistema
GET {{base_url}}/api/admin/estatisticas
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("Tem totalUsuarios", function() {
    client.assert(response.body.totalUsuarios !== undefined);
  });
  client.test("Tem totalVagas", function() {
    client.assert(response.body.totalVagas !== undefined);
  });
  client.test("Tem totalCandidaturas", function() {
    client.assert(response.body.totalCandidaturas !== undefined);
  });
  client.test("Totais são numéricos e >= 0", function() {
    client.assert(response.body.totalUsuarios >= 0);
    client.assert(response.body.totalCandidatos >= 0);
    client.assert(response.body.totalEmpresas >= 0);
  });
%}

