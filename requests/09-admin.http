### ============================================================
### ADMIN — Gestão administrativa do sistema
### Pré-requisito: 01-auth.http (token_admin)
### Todos os endpoints exigem role ADMIN
### ============================================================

### ── GESTÃO DE USUÁRIOS ──────────────────────────────────────────

### [1] Listar todos os usuários
GET {{base_url}}/api/admin/usuarios
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("É uma lista", function() { client.assert(Array.isArray(response.body)); });
  if (response.body.length > 0) {
    const candidato = response.body.find(u => u.tipoUsuario === "CANDIDATO");
    const empresa   = response.body.find(u => u.tipoUsuario === "EMPRESA");
    if (candidato) client.global.set("usuario_candidato_id", candidato.id);
    if (empresa)   client.global.set("usuario_empresa_id",   empresa.id);
  }
%}

###

### [2] Buscar usuário por ID
GET {{base_url}}/api/admin/usuarios/{{usuario_candidato_id}}
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("ID correto", function() {
    client.assert(String(response.body.id) === String(client.global.get("usuario_candidato_id")));
  });
%}

###

### [3] Atualizar dados de um usuário (ADMIN pode editar qualquer usuário)
PUT {{base_url}}/api/admin/usuarios/{{usuario_candidato_id}}
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "nome": "João da Silva (editado)",
  "email": "joao.candidato@teste.com",
  "dataNascimento": "1995-06-15T00:00:00",
  "tipoUsuario": "CANDIDATO",
  "ativo": true
}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("Nome atualizado", function() {
    client.assert(response.body.nome === "João da Silva (editado)");
  });
%}

###

### [4] Desativar usuário
PATCH {{base_url}}/api/admin/usuarios/{{usuario_candidato_id}}/desativar
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 204", function() { client.assert(response.status === 204); });
%}

###

### [5] Ativar usuário
PATCH {{base_url}}/api/admin/usuarios/{{usuario_candidato_id}}/ativar
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 204", function() { client.assert(response.status === 204); });
%}

###

### [6] Alterar tipo de usuário (CANDIDATO → CANDIDATO, sem mudança real)
PATCH {{base_url}}/api/admin/usuarios/{{usuario_candidato_id}}/tipo/CANDIDATO
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200 ou 204", function() {
    client.assert(response.status === 200 || response.status === 204);
  });
%}

