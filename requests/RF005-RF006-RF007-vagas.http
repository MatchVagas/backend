### [RF007] Listar todas as vagas (público — sem token)
GET {{base_url}}/api/vagas

> {%
  client.test("Status 200 - OK (público)", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Retorna array", function() {
    client.assert(Array.isArray(response.body), "Resposta não é array");
  });
%}

###

### [RF007] Buscar vagas por título
GET {{base_url}}/api/vagas?titulo=Java

> {%
  client.test("Status 200 - OK", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Todos os resultados contêm Java no título", function() {
    response.body.forEach(function(vaga) {
      client.assert(vaga.titulo.toLowerCase().includes("java"), "Vaga fora do filtro: " + vaga.titulo);
    });
  });
%}

