### [RF005] Cadastrar nova vaga
### PRÉ-REQUISITO: token de usuário EMPRESA
POST {{base_url}}/api/vagas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "empresaId": 1,
  "titulo": "Desenvolvedor Java Pleno",
  "descricao": "Vaga para desenvolvedor Java com experiência em Spring Boot e microsserviços",
  "requisitos": "Java 17+, Spring Boot, JPA/Hibernate, Git",
  "tipoVagaId": 1,
  "modalidadeId": 1,
  "salarioMinimo": 5000.00,
  "salarioMaximo": 8000.00,
  "beneficios": "Vale refeição, Plano de saúde, Gympass",
  "cargaHoraria": "40h/semana",
  "idadeMinima": 18,
  "idadeMaxima": 45,
  "escolaridadeId": 1,
  "areaAtuacao": "Tecnologia",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": 1,
  "numeroVagas": 3,
  "cidadeId": 1
}

> {%
  client.test("Status 201 - Vaga criada", function() {
    client.assert(response.status === 201, "Esperado 201, recebido: " + response.status);
  });
  client.test("Retorna título da vaga", function() {
    client.assert(response.body.titulo === "Desenvolvedor Java Pleno", "Título errado");
  });
  client.test("Retorna empresa vinculada", function() {
    client.assert(response.body.nomeFantasiaEmpresa !== undefined, "Empresa não retornada");
  });
  client.global.set("vagaId", response.body.id);
%}

###

### [RF005 - ERRO] Salário mínimo maior que máximo
POST {{base_url}}/api/vagas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "empresaId": 1,
  "titulo": "Vaga Inválida",
  "descricao": "Descrição com pelo menos vinte caracteres aqui",
  "requisitos": "Requisitos",
  "tipoVagaId": 1,
  "modalidadeId": 1,
  "salarioMinimo": 9000.00,
  "salarioMaximo": 5000.00,
  "cargaHoraria": "40h/semana",
  "idadeMinima": 18,
  "idadeMaxima": 45,
  "escolaridadeId": 1,
  "areaAtuacao": "TI",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": 1,
  "numeroVagas": 1,
  "cidadeId": 1
}

> {%
  client.test("Status 400 - Salário inválido", function() {
    client.assert(response.status === 400, "Esperado 400, recebido: " + response.status);
  });
%}

###

### [RF006] Atualizar vaga existente
PUT {{base_url}}/api/vagas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "empresaId": 1,
  "titulo": "Desenvolvedor Java Sênior",
  "descricao": "Vaga atualizada para nível sênior com foco em arquitetura",
  "requisitos": "Java 17+, Spring Boot, Kubernetes, Docker",
  "tipoVagaId": 1,
  "modalidadeId": 1,
  "salarioMinimo": 8000.00,
  "salarioMaximo": 12000.00,
  "beneficios": "Vale refeição, Plano de saúde, Stock options",
  "cargaHoraria": "40h/semana",
  "idadeMinima": 25,
  "idadeMaxima": 50,
  "escolaridadeId": 1,
  "areaAtuacao": "Tecnologia",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": 1,
  "numeroVagas": 2,
  "cidadeId": 1
}

> {%
  client.test("Status 200 - Vaga atualizada", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Título foi atualizado", function() {
    client.assert(response.body.titulo === "Desenvolvedor Java Sênior", "Título não atualizado");
  });
%}

