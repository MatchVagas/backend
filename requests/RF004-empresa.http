### ============================================================
### RF004 — Gerenciamento de Perfil da Empresa
### PRÉ-REQUISITO: fazer login com usuário EMPRESA e copiar
###   o token retornado para {{token}}
###
### Login de empresa:
###   POST /api/auth/login  { "email": "rh@techcorp.com", "senha": "senha123" }
### ============================================================

### [RF004] Cadastrar empresa (perfil completo)
### ATENÇÃO: porteId e ramoId devem existir no banco
POST {{base_url}}/api/empresas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cnpj": "12.345.678/0001-90",
  "razaoSocial": "Tech Corp Ltda",
  "nomeFantasia": "Tech Corp",
  "descricao": "Empresa de desenvolvimento de software",
  "porteId": 1,
  "ramoId": 1,
  "site": "https://techcorp.com.br"
}

> {%
  client.test("Status 201 - Empresa criada", function() {
    client.assert(response.status === 201, "Esperado 201, recebido: " + response.status);
  });
  client.test("Retorna nomeFantasia", function() {
    client.assert(response.body.nomeFantasia === "Tech Corp", "Nome fantasia errado");
  });
  client.global.set("empresaId", response.body.id);
%}

###

### [RF004] Buscar empresa por ID (público — sem token)
GET {{base_url}}/api/empresas/1

> {%
  client.test("Status 200 - OK (endpoint público)", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
%}

###

### [RF004] Listar todas as empresas (público)
GET {{base_url}}/api/empresas

> {%
  client.test("Status 200 - Lista retornada", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Retorna array", function() {
    client.assert(Array.isArray(response.body), "Resposta não é um array");
  });
%}

###

### [RF004] Atualizar perfil da empresa
PUT {{base_url}}/api/empresas/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cnpj": "12.345.678/0001-90",
  "razaoSocial": "Tech Corp Ltda",
  "nomeFantasia": "Tech Corp 2.0",
  "descricao": "Empresa de tecnologia e inovação",
  "porteId": 1,
  "ramoId": 1,
  "site": "https://techcorp2.com.br"
}

> {%
  client.test("Status 200 - Empresa atualizada", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Nome fantasia foi atualizado", function() {
    client.assert(response.body.nomeFantasia === "Tech Corp 2.0", "Nome não foi atualizado");
  });
%}

###

### [RF004 - ERRO] CNPJ duplicado
POST {{base_url}}/api/empresas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "cnpj": "12.345.678/0001-90",
  "razaoSocial": "Outra Empresa",
  "nomeFantasia": "Outra",
  "porteId": 1,
  "ramoId": 1
}

> {%
  client.test("Status 400 - CNPJ duplicado", function() {
    client.assert(response.status === 400, "Esperado 400, recebido: " + response.status);
  });
%}
