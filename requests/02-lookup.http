# ──────────────────────────────────────────
# STATUS DE VAGA
# ──────────────────────────────────────────

### [21] Listar status de vaga (público) — captura ID de produção (preferência: "ativa")
GET {{base_url}}/api/lookup/vagas/status

> {%
  const ativa = response.body.find(s => s.descricao && s.descricao.toLowerCase() === "ativa");
  client.global.set("status_vaga_id", ativa ? ativa.id : response.body[0].id);
  client.test("Status 200 (ou 404 se item não foi criado)", function() { client.assert(response.status === 200 || response.status === 404); });
  client.test("Existe status 'ativa'", function() { client.assert(ativa !== undefined); });
%}

###

### [22] Criar status de vaga de teste (ADMIN) — usa _tmp
POST {{base_url}}/api/lookup/vagas/status
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "descricao": "Rascunho Test"
}

> {%
  if (response.status === 201) {
    client.global.set("status_vaga_tmp", response.body.id);
  }
  client.test("Status 201 (ou já existente)", function() { client.assert(response.status === 201 || response.status === 400 || response.status === 409); });
%}

