### [27] Listar departamentos (público) — captura ID de produção
GET {{base_url}}/api/lookup/sistema/departamentos

> {%
  if (response.body.length > 0) {
    client.global.set("departamento_id", response.body[0].id);
  }
  client.test("Status 200 (ou 404 se item não foi criado)", function() { client.assert(response.status === 200 || response.status === 404); });
%}

###

### [28] Criar departamento (ADMIN)
# Cria departamento se ainda não existir; usa _tmp para não sobrescrever departamento_id
POST {{base_url}}/api/lookup/sistema/departamentos
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "nome": "Jurídico Test"
}

> {%
  if (response.status === 201) {
    client.global.set("departamento_tmp", response.body.id);
    // Só atualiza departamento_id se ainda não foi definido
    if (!client.global.get("departamento_id")) {
      client.global.set("departamento_id", response.body.id);
    }
  }
  client.test("Status 201 (ou já existente)", function() { client.assert(response.status === 201 || response.status === 400 || response.status === 409); });
%}

