### ============================================================
### RF010 — Administração do Sistema
### PRÉ-REQUISITO: token de usuário com tipoUsuario = ADMIN
###
### Para criar um admin no banco diretamente (primeira vez):
###   UPDATE usuarios SET tipo_usuario = 'ADMIN' WHERE email = 'admin@matchvagas.com';
###   INSERT INTO administradores (usuarios_id, nivel, departamento_id, permissoes)
###   VALUES (1, 'SUPER', 1, 'TUDO');
### ============================================================

### Login como admin — salva token
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@matchvagas.com",
  "senha": "senha123"
}

> {%
  client.test("Status 200 - Login admin OK", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Perfil é ADMIN", function() {
    client.assert(response.body.perfil === "ADMIN", "Perfil não é ADMIN: " + response.body.perfil);
  });
  client.global.set("adminToken", response.body.token);
%}

###

### [RF010] Listar todos os usuários
GET {{base_url}}/api/admin/usuarios
Authorization: Bearer {{adminToken}}

> {%
  client.test("Status 200 - OK", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Retorna array de usuários", function() {
    client.assert(Array.isArray(response.body), "Resposta não é array");
  });
%}

