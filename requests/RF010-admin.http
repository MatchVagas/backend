###

### [RF010] Promover usuário a administrador
### Troque usuarioId pelo ID de um usuário existente no banco
POST {{base_url}}/api/admin/admins
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "usuarioId": 2,
  "nivel": "MODERADOR",
  "departamentoId": 1,
  "permissoes": "USUARIOS, VAGAS"
}

> {%
  client.test("Status 201 - Admin criado", function() {
    client.assert(response.status === 201, "Esperado 201, recebido: " + response.status);
  });
  client.test("Retorna dados do admin", function() {
    client.assert(response.body.nivel === "MODERADOR", "Nível errado");
  });
%}

