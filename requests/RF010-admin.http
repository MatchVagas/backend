###

### [RF010 - ERRO] Acesso à área admin sem token de ADMIN
GET {{base_url}}/api/admin/usuarios
Authorization: Bearer {{token}}

> {%
  client.test("Status 403 - Acesso negado para não-admin", function() {
    client.assert(response.status === 403, "Esperado 403, recebido: " + response.status);
  });
%}

###

### [RF010 - ERRO] Excluir usuário inexistente
DELETE {{base_url}}/api/admin/usuarios/9999
Authorization: Bearer {{adminToken}}

> {%
  client.test("Status 404 - Usuário não encontrado", function() {
    client.assert(response.status === 404, "Esperado 404, recebido: " + response.status);
  });
%}
