### ============================================================
### USUÁRIOS - Gestão de contas de usuário
### ============================================================

### [1] Listar todos os usuários
GET {{base_url}}/api/usuarios
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  if (response.body && response.body.length > 0) {
    const cand = response.body.find(u => u.tipoUsuario === "CANDIDATO");
    const emp  = response.body.find(u => u.tipoUsuario === "EMPRESA");
    const adm  = response.body.find(u => u.tipoUsuario === "ADMIN");
    if (cand) client.global.set("usuario_candidato_id", cand.id);
    if (emp)  client.global.set("usuario_empresa_id",   emp.id);
    if (adm)  client.global.set("usuario_admin_id",     adm.id);
  }
%}

###

### [2] Buscar usuário por ID
GET {{base_url}}/api/usuarios/{{usuario_candidato_id}}
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
  client.test("ID correto", function() {
    client.assert(response.body.id == client.global.get("usuario_candidato_id"));
  });
%}

###

### [3] Buscar usuário por e-mail
GET {{base_url}}/api/usuarios/email/joao.candidato@teste.com
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [4] Criar usuário diretamente via endpoint (sem /auth/register)
POST {{base_url}}/api/usuarios
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "nome": "Carlos Teste",
  "email": "carlos.teste@matchvagas.com",
  "senha": "senha123",
  "dataNascimento": "1990-08-25T00:00:00",
  "tipoUsuario": "CANDIDATO",
  "ativo": true
}

> {%
  if (response.status === 201) client.global.set("usuario_temp_id", response.body.id);
  client.test("Status 201 (ou já existente)", function() {
    client.assert(response.status === 201 || response.status === 400 || response.status === 409);
  });
%}

###

### [5] Atualizar usuário
PUT {{base_url}}/api/usuarios/{{usuario_temp_id}}
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "nome": "Carlos Teste Atualizado",
  "email": "carlos.atualizado@matchvagas.com",
  "senha": "novaSenha456",
  "dataNascimento": "1990-08-25T00:00:00",
  "tipoUsuario": "CANDIDATO",
  "ativo": true
}

> {%
  client.test("Status 200 (ou 404 se não criado)", function() { client.assert(response.status === 200 || response.status === 404); });
%}

###

### [6] Excluir usuário
DELETE {{base_url}}/api/usuarios/{{usuario_temp_id}}
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 204 (ou 404 se não criado)", function() { client.assert(response.status === 204 || response.status === 404); });
%}

###

### [7] Buscar usuário inexistente (deve retornar 404)
GET {{base_url}}/api/usuarios/999999
Authorization: Bearer {{token_admin}}

> {%
  client.test("Status 404", function() { client.assert(response.status === 404); });
%}

###

### [8] Criar usuário com e-mail duplicado (deve retornar 400 ou 409)
POST {{base_url}}/api/usuarios
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "nome": "Duplicado",
  "email": "joao.candidato@teste.com",
  "senha": "senha123",
  "dataNascimento": "1995-06-15T00:00:00",
  "tipoUsuario": "CANDIDATO",
  "ativo": true
}

> {%
  client.test("E-mail duplicado bloqueado", function() {
    client.assert(response.status === 400 || response.status === 409 || response.status === 500);
  });
%}
