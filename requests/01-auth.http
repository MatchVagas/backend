###

### [4] Login — Candidato (captura token automaticamente)
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
  "email": "joao.candidato@teste.com",
  "senha": "senha123"
}

> {%
  client.global.set("token_candidato", response.body.token);
  client.test("Login candidato OK", function() { client.assert(response.status === 200); });
  client.test("Token presente", function() { client.assert(response.body.token !== ""); });
%}

###

### [5] Login — Empresa (captura token automaticamente)
POST {{base_url}}/api/auth/login
Content-Type: application/json

{
  "email": "maria.empresa@teste.com",
  "senha": "senha123"
}

> {%
  client.global.set("token_empresa", response.body.token);
  client.test("Login empresa OK", function() { client.assert(response.status === 200); });
%}

