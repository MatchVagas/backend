### ============================================================
### RF008 — Candidatura à Vaga
### RF009 — Acompanhamento de Candidaturas
### PRÉ-REQUISITO: token de usuário CANDIDATO
### ============================================================

### [RF008] Candidatar-se a uma vaga
POST {{base_url}}/api/candidaturas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "vagaId": 1
}

> {%
  client.test("Status 201 - Candidatura registrada", function() {
    client.assert(response.status === 201, "Esperado 201, recebido: " + response.status);
  });
  client.test("Retorna ID da vaga", function() {
    client.assert(response.body.vagaId === 1, "ID da vaga errado");
  });
  client.test("Status inicial é EM_ANALISE ou similar", function() {
    client.assert(response.body.status !== undefined, "Status não retornado");
  });
  client.test("Retorna data da candidatura", function() {
    client.assert(response.body.dataCandidatura !== undefined, "Data não retornada");
  });
  client.global.set("candidaturaId", response.body.id);
%}

###

### [RF008 - ERRO] Candidatura duplicada deve retornar 400
POST {{base_url}}/api/candidaturas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "vagaId": 1
}

> {%
  client.test("Status 400 - Candidatura duplicada rejeitada", function() {
    client.assert(response.status === 400, "Esperado 400, recebido: " + response.status);
  });
  client.test("Mensagem indica candidatura duplicada", function() {
    client.assert(response.body.message !== undefined, "Mensagem de erro não retornada");
  });
%}

###

### [RF008 - ERRO] Candidatar a vaga inexistente
POST {{base_url}}/api/candidaturas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "vagaId": 9999
}

> {%
  client.test("Status 400 - Vaga não encontrada", function() {
    client.assert(response.status === 400, "Esperado 400, recebido: " + response.status);
  });
%}

###

### [RF008 - ERRO] Candidatar sem token
POST {{base_url}}/api/candidaturas
Content-Type: application/json

{
  "vagaId": 1
}

> {%
  client.test("Status 403 - Não autorizado", function() {
    client.assert(response.status === 403, "Esperado 403, recebido: " + response.status);
  });
%}

###

### [RF009] Listar minhas candidaturas com status
GET {{base_url}}/api/candidaturas/minhas
Authorization: Bearer {{token}}

> {%
  client.test("Status 200 - OK", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Retorna array de candidaturas", function() {
    client.assert(Array.isArray(response.body), "Resposta não é array");
  });
  client.test("Cada candidatura tem status", function() {
    response.body.forEach(function(c) {
      client.assert(c.status !== undefined, "Candidatura sem status: ID " + c.id);
    });
  });
  client.test("Cada candidatura tem título da vaga", function() {
    response.body.forEach(function(c) {
      client.assert(c.tituloVaga !== undefined, "Candidatura sem título da vaga: ID " + c.id);
    });
  });
%}

###

### [RF009] Detalhar candidatura específica
GET {{base_url}}/api/candidaturas/1
Authorization: Bearer {{token}}

> {%
  client.test("Status 200 - OK", function() {
    client.assert(response.status === 200, "Esperado 200, recebido: " + response.status);
  });
  client.test("Retorna dados completos da candidatura", function() {
    client.assert(response.body.id !== undefined, "ID não retornado");
    client.assert(response.body.vagaId !== undefined, "Vaga não retornada");
    client.assert(response.body.dataCandidatura !== undefined, "Data não retornada");
  });
%}

###

### [RF009 - ERRO] Candidatura inexistente
GET {{base_url}}/api/candidaturas/9999
Authorization: Bearer {{token}}

> {%
  client.test("Status 404 - Candidatura não encontrada", function() {
    client.assert(response.status === 404, "Esperado 404, recebido: " + response.status);
  });
%}
