### [11] Criar vaga com título muito curto (deve retornar 400)
POST {{base_url}}/api/vagas
Authorization: Bearer {{token_empresa}}
Content-Type: application/json

{
  "empresaId": {{empresa_id}},
  "titulo": "Dev",
  "descricao": "Descrição muito curta",
  "requisitos": "Java",
  "tipoVagaId": {{tipo_vaga_id}},
  "modalidadeId": {{modalidade_id}},
  "salarioMinimo": 3000.00,
  "salarioMaximo": 5000.00,
  "cargaHoraria": "40h",
  "escolaridadeId": {{escolaridade_id}},
  "areaAtuacao": "TI",
  "statusVagaId": {{status_vaga_id}},
  "cidadeId": {{cidade_id}}
}

> {%
  client.test("Título inválido rejeitado", function() { client.assert(response.status === 400); });
%}

###

### [12] Candidato tenta criar vaga (deve retornar 403)
POST {{base_url}}/api/vagas
Authorization: Bearer {{token_candidato}}
Content-Type: application/json

{
  "empresaId": 1,
  "titulo": "Candidato Não Deve Criar",
  "descricao": "Este request deve ser bloqueado pelo servidor.",
  "requisitos": "Nenhum",
  "tipoVagaId": 1,
  "modalidadeId": 1,
  "salarioMinimo": 1000.00,
  "salarioMaximo": 2000.00,
  "cargaHoraria": "40h",
  "escolaridadeId": 1,
  "areaAtuacao": "TI",
  "statusVagaId": 1,
  "cidadeId": 1
}

> {%
  client.test("Candidato bloqueado", function() { client.assert(response.status === 403); });
%}

###

### [13] Buscar vaga inexistente (deve retornar 404)
GET {{base_url}}/api/vagas/999999

> {%
  client.test("Status 404", function() { client.assert(response.status === 404); });
%}
