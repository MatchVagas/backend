### [9] Atualizar vaga (EMPRESA autenticada)
PUT {{base_url}}/api/vagas/{{vaga_id}}
Authorization: Bearer {{token_empresa}}
Content-Type: application/json

{
  "empresaId": {{empresa_id}},
  "titulo": "Desenvolvedor Java Sênior",
  "descricao": "Buscamos um desenvolvedor Java Sênior com sólida experiência em Spring Boot, microsserviços e AWS para liderar projetos de backend.",
  "requisitos": "Java 17+, Spring Boot, Kubernetes, AWS, REST APIs, SQL, Git",
  "tipoVagaId": {{tipo_vaga_id}},
  "modalidadeId": {{modalidade_id}},
  "salarioMinimo": 10000.00,
  "salarioMaximo": 15000.00,
  "beneficios": "VR, VT, Plano de Saúde, Gympass, Stock Options",
  "cargaHoraria": "40h semanais",
  "idadeMinima": 25,
  "idadeMaxima": 55,
  "escolaridadeId": {{escolaridade_id}},
  "areaAtuacao": "Tecnologia da Informação",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": {{status_vaga_id}},
  "numeroVagas": 2,
  "cidadeId": {{cidade_id}}
}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

