### ============================================================
### VAGAS - Gestão de vagas de emprego
### Leitura pública / Escrita para EMPRESA ou ADMIN
### ============================================================

### [1] Listar todas as vagas (público)
GET {{base_url}}/api/vagas

> {%
  client.global.set("vaga_id", response.body[0] ? response.body[0].id : 1);
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [2] Buscar vaga por ID (público)
GET {{base_url}}/api/vagas/{{vaga_id}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [3] Buscar vagas com filtros (público)
GET {{base_url}}/api/vagas?titulo=Java&areaAtuacao=Tecnologia

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [4] Buscar vagas por tipoVaga e modalidade
GET {{base_url}}/api/vagas?tipoVagaId={{tipo_vaga_id}}&modalidadeId={{modalidade_id}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [5] Listar vagas de uma empresa específica (público)
GET {{base_url}}/api/vagas/empresa/{{empresa_id}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [6] Listar minhas vagas (EMPRESA autenticada)
GET {{base_url}}/api/vagas/minhas
Authorization: Bearer {{token_empresa}}

> {%
  client.test("Status 200", function() { client.assert(response.status === 200); });
%}

###

### [7] Criar vaga (EMPRESA autenticada)
# Pré-requisitos: empresa criada (06-empresas) e lookups carregados (02-lookup e 03-localizacao)
POST {{base_url}}/api/vagas
Authorization: Bearer {{token_empresa}}
Content-Type: application/json

{
  "empresaId": {{empresa_id}},
  "titulo": "Desenvolvedor Java Pleno",
  "descricao": "Estamos buscando um desenvolvedor Java Pleno com experiência em Spring Boot para integrar nossa equipe de backend.",
  "requisitos": "Java 17+, Spring Boot, REST APIs, SQL, Git",
  "tipoVagaId": {{tipo_vaga_id}},
  "modalidadeId": {{modalidade_id}},
  "salarioMinimo": 6000.00,
  "salarioMaximo": 9000.00,
  "beneficios": "VR, VT, Plano de Saúde, Gympass",
  "cargaHoraria": "40h semanais",
  "idadeMinima": 18,
  "idadeMaxima": 45,
  "escolaridadeId": {{escolaridade_id}},
  "areaAtuacao": "Tecnologia da Informação",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": {{status_vaga_id}},
  "numeroVagas": 3,
  "cidadeId": {{cidade_id}}
}

> {%
  client.global.set("vaga_id", response.body.id);
  client.test("Status 201", function() { client.assert(response.status === 201); });
  client.test("Título correto", function() {
    client.assert(response.body.titulo === "Desenvolvedor Java Pleno");
  });
%}

###

### [8] Criar vaga como ADMIN
POST {{base_url}}/api/vagas
Authorization: Bearer {{token_admin}}
Content-Type: application/json

{
  "empresaId": {{empresa_id}},
  "titulo": "Analista de Dados Júnior",
  "descricao": "Oportunidade para profissional iniciante na área de análise de dados e business intelligence.",
  "requisitos": "Excel avançado, noções de SQL, PowerBI",
  "tipoVagaId": {{tipo_vaga_id}},
  "modalidadeId": {{modalidade_id}},
  "salarioMinimo": 3000.00,
  "salarioMaximo": 4500.00,
  "beneficios": "VR, VT, Plano de Saúde",
  "cargaHoraria": "40h semanais",
  "idadeMinima": 18,
  "idadeMaxima": 35,
  "escolaridadeId": {{escolaridade_id}},
  "areaAtuacao": "Análise de Dados",
  "dataExpiracao": "2026-12-31T23:59:59",
  "statusVagaId": {{status_vaga_id}},
  "numeroVagas": 1,
  "cidadeId": {{cidade_id}}
}

> {%
  client.test("Status 201", function() { client.assert(response.status === 201); });
%}

