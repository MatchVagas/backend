### [10] Excluir vaga (EMPRESA autenticada)
DELETE {{base_url}}/api/vagas/{{vaga_id}}
Authorization: Bearer {{token_empresa}}

> {%
  client.test("Status 204", function() { client.assert(response.status === 204); });
%}

